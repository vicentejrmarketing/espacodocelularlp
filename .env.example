# NOMES das variáveis (Vercel → Project → Settings → Environment Variables).
# VALORES chegam pela equipe CRM por canal apropriado. Nunca no Git, em capturas ou em logs.

# ---------- Receptor de CADASTROS (contrato PAG+AGENDAMENTO) ----------
# URL final = {CRM_BASE_URL}/api/v1/webhooks/pag-agendamento/{CRM_SOURCE_ID}/cadastro
CRM_BASE_URL=
# UUID da fonte fornecido pela equipe CRM (não inventar)
CRM_SOURCE_ID=
# Segredo do HMAC do cadastro (X-Pag-Agendamento-Signature, hex sem prefixo). NÃO é o segredo do Cal.com.
CRM_CADASTRO_SECRET=
# "form" (padrão) ou "json"
CRM_CADASTRO_FORMAT=form
CRM_TIMEOUT_MS=8000

# ---------- Guarda durável da LP ----------
# Armazenamento chave-valor com API REST compatível com Redis (Vercel KV / Upstash), com suporte a EVAL.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# "1": sem armazenamento a página não afirma recebimento sem confirmação do CRM e gera alerta
PERSISTENCIA_OBRIGATORIA=1

# ---------- Agendador ----------
# Credencial própria do agendador (cron da VPS / GitHub Actions / cron da Vercel)
CRON_SECRET=

# ---------- Central de leads (/central.html) ----------
# Usa o mesmo armazenamento acima (KV_REST_API_URL / KV_REST_API_TOKEN). Sem ele a central não funciona.
# Login por e-mail: os e-mails das lojas e o resumo scrypt das senhas estão em api/_acessos.js.
# Opcional: substituir a senha de uma loja (mínimo 8 caracteres)
CENTRAL_SENHA_ITAJAI=
CENTRAL_SENHA_NAVEGANTES=
CENTRAL_SENHA_CAMBORIU=
# Opcional: acesso do dono, vê todas as lojas
CENTRAL_GERAL_EMAIL=
CENTRAL_SENHA_GERAL=
